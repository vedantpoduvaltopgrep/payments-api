# Copy to .env for local development. Never commit a filled-in .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora
DB_POOL_MAX=10

JWT_ISSUER=https://auth.aurorapay.example
JWT_AUDIENCE=aurora-payments-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_PRIVATE_KEY_PATH=./.secrets/jwt-signing.key
JWT_PUBLIC_KEY_PATH=./.secrets/jwt-signing.pub

# 32 raw bytes, base64. In production the KMS unwraps this at pod start.
CARD_VAULT_DATA_KEY=
# 16 raw bytes, base64. Only needed to read pre-2019 rows.
CARD_VAULT_LEGACY_KEY=

WEBHOOK_SIGNING_KEY_PATH=./.secrets/webhook-signing.key
PARTNER_CERT_DIR=./certs
WEBHOOK_TOLERANCE=300

BANK_SFTP_HOST=sftp.acquirer.example
SETTLEMENT_DIR=./tmp/settlement

MFA_ISSUER=Aurora Pay
MFA_WINDOW=1
